# =============================================================================
# BuildNest — Production Docker Compose Environment Variables (docker-compose.prod.yml)
# =============================================================================
# Copy to .env.prod and fill in every REQUIRED value before deploying:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# This file covers only variables consumed directly by docker-compose.prod.yml
# (infrastructure, resource limits, TLS domain). Application-level Spring Boot
# variables (JWT_SECRET, RAZORPAY_*, MAIL_*, etc.) are the same ones documented in
# backend/.env.example — set them here too, since docker-compose.prod.yml passes
# them through to the backend container's environment.
#
# Column guide: Type | Default | Class (SECRET = never commit) | Req (REQUIRED/optional)
# =============================================================================


# -----------------------------------------------------------------------------
# TLS / Domain (nginx-proxy)
# -----------------------------------------------------------------------------

# Public domain name the certificate is issued for and nginx-proxy's server_name.
# Type: string | Default: localhost | Class: non-secret | Req: REQUIRED for a real cloud deploy
DOMAIN_NAME=localhost

# Contact email for Let's Encrypt registration — only used if cert-init is swapped
# for certbot per nginx-proxy/README.md; unused for the self-signed compose target.
# Type: string | Class: non-secret | Req: required when using certbot
LETSENCRYPT_EMAIL=


# -----------------------------------------------------------------------------
# Resource Limits — all optional, each defaults to a conservative value inline
# in docker-compose.prod.yml if unset. Override per deployment target's real
# hardware. cpus is a fractional core count; memory accepts Docker's byte suffixes
# (e.g. 512M, 2G).
# -----------------------------------------------------------------------------

MYSQL_CPU_LIMIT=2
MYSQL_MEMORY_LIMIT=2G
MYSQL_CPU_RESERVATION=0.5
MYSQL_MEMORY_RESERVATION=1G

REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=512M
REDIS_CPU_RESERVATION=0.25
REDIS_MEMORY_RESERVATION=256M

ES_CPU_LIMIT=2
ES_MEMORY_LIMIT=2G
ES_CPU_RESERVATION=0.5
ES_MEMORY_RESERVATION=1G
ES_JAVA_OPTS=-Xms1g -Xmx1g

BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=1536M
BACKEND_CPU_RESERVATION=0.5
BACKEND_MEMORY_RESERVATION=768M

FRONTEND_CPU_LIMIT=1
FRONTEND_MEMORY_LIMIT=256M
FRONTEND_CPU_RESERVATION=0.1
FRONTEND_MEMORY_RESERVATION=128M

NGINX_PROXY_CPU_LIMIT=1
NGINX_PROXY_MEMORY_LIMIT=256M
NGINX_PROXY_CPU_RESERVATION=0.1
NGINX_PROXY_MEMORY_RESERVATION=128M


# -----------------------------------------------------------------------------
# Infrastructure secrets/config — same variables as backend/.env.example.
# Repeated here (not sourced automatically) because docker-compose.prod.yml is
# started with --env-file .env.prod, a separate file from backend/.env used by
# the dev compose stack.
# -----------------------------------------------------------------------------

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=buildnest_ecommerce
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
REDIS_PASSWORD=
ELASTIC_PASSWORD=
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MONITORING_USERNAME=monitoring
MONITORING_PASSWORD=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@buildnest.com
