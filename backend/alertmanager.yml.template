# This is a TEMPLATE, not the file Alertmanager actually reads -- the alertmanager-config-render
# service (docker-compose.yml) substitutes the env placeholders below and strips whichever
# receiver block (Slack / email) is disabled, then writes the rendered result to a shared
# volume before the alertmanager container starts. Mirrors the prometheus-config-render
# sidecar pattern introduced in #324.
#
# Notification channel is configurable per #122's AC ("routed to configurable notification
# channel (email/Slack)"): set ALERTMANAGER_SLACK_ENABLED and/or ALERTMANAGER_EMAIL_ENABLED in
# .env. Both may be enabled at once -- alerts fan out to every enabled channel.

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'component']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default'
  routes:
    # Critical alerts repeat more often so an unresolved page doesn't go quiet.
    - match:
        severity: critical
      receiver: 'default'
      repeat_interval: 1h

receivers:
  - name: 'default'
    # BEGIN_SLACK
    slack_configs:
      - api_url: '__SLACK_WEBHOOK_URL__'
        channel: '__SLACK_CHANNEL__'
        send_resolved: true
        title: '{{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})'
        text: '{{ range .Alerts }}{{ .Annotations.summary }}\n{{ .Annotations.description }}\n{{ end }}'
    # END_SLACK
    # BEGIN_EMAIL
    email_configs:
      - to: '__ALERT_EMAIL_TO__'
        from: '__ALERT_EMAIL_FROM__'
        smarthost: '__SMTP_HOST__:__SMTP_PORT__'
        auth_username: '__SMTP_USERNAME__'
        auth_password: '__SMTP_PASSWORD__'
        require_tls: false
        send_resolved: true
    # END_EMAIL

inhibit_rules:
  # A critical alert for the same component supersedes its warning-tier counterpart.
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'component']
