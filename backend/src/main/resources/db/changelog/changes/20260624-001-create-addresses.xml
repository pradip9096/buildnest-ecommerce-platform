<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Issue #104 / #78 (USR-01): User address book -->
    <changeSet id="20260624-001-create-addresses" author="buildnest-team">
        <comment>Create addresses table for user address book (USR-01, #78)</comment>

        <createTable tableName="addresses">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="street_address" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="postal_code" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="is_default" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="address_type" type="VARCHAR(20)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_addresses_user"
            baseTableName="addresses" baseColumnNames="user_id"
            referencedTableName="users" referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createIndex tableName="addresses" indexName="idx_addresses_user_id">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="addresses" indexName="idx_addresses_user_default">
            <column name="user_id"/>
            <column name="is_default"/>
        </createIndex>

        <rollback>
            <dropTable tableName="addresses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
