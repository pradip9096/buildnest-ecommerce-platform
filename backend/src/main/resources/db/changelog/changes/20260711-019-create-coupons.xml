<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Issue #77 (CHK-02): Coupon/discount code application at checkout -->
    <changeSet id="20260711-019-create-coupons" author="buildnest-team">
        <!-- In the test profile, ddl-auto=create-drop lets Hibernate generate "coupons" directly
             from the Coupon entity for a @DataJpaTest-style context, which can race ahead of this
             changeset for that isolated context — same drift class as #81/#82's products/
             product_images precedent. Guard so this changeset is idempotent either way. -->
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="coupons"/>
            </not>
        </preConditions>

        <comment>Create coupons table for checkout discount codes (CHK-02, #77)</comment>

        <createTable tableName="coupons">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_coupons_code"/>
            </column>
            <column name="discount_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_value" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="min_order_value" type="DECIMAL(19,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="usage_limit" type="INT"/>
            <column name="usage_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="DATETIME"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="coupons" indexName="idx_coupons_active">
            <column name="is_active"/>
        </createIndex>

        <rollback>
            <dropTable tableName="coupons"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
