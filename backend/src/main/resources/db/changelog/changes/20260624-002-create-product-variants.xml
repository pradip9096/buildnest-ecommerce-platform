<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Issue #104 / #81 (PROD-01): Product variant support (size, colour) -->
    <changeSet id="20260624-002-create-product-variants" author="buildnest-team">
        <!-- "products" (plural) is not created by any Liquibase changeset in this repo — same
             drift class as #241 and the categories/inventory precedents (see
             docs/wiki/learned-lessons/known-table-drift-list-should-be-checked-before-writing-changesets.md).
             In the test profile, Liquibase runs before Hibernate's create-drop creates the table,
             so it does not exist yet here; Hibernate creates product_variants directly from the
             ProductVariant entity in that profile instead. -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="products"/>
        </preConditions>

        <comment>Create product_variants table for size/colour variants (PROD-01, #81)</comment>

        <createTable tableName="product_variants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sku" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_variant_sku"/>
            </column>
            <column name="size" type="VARCHAR(50)"/>
            <column name="colour" type="VARCHAR(50)"/>
            <column name="price_adjustment" type="DECIMAL(19,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <!-- No stock_quantity column here: per-variant stock is tracked via the shared
                 inventory table (inventory.variant_id), reusing existing reservation/threshold/
                 low-stock logic instead of duplicating it — see ADR discussion in #81. -->
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_variants_product"
            baseTableName="product_variants" baseColumnNames="product_id"
            referencedTableName="products" referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createIndex tableName="product_variants" indexName="idx_variants_product_id">
            <column name="product_id"/>
        </createIndex>

        <createIndex tableName="product_variants" indexName="idx_variants_product_active">
            <column name="product_id"/>
            <column name="is_active"/>
        </createIndex>

        <rollback>
            <dropTable tableName="product_variants"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
