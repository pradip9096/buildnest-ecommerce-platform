<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Issue #91 (AUTH-02): one-time recovery codes issued when TOTP 2FA is enabled -->
    <changeSet id="20260808-002-create-recovery-codes" author="buildnest-team">
        <comment>8 one-time recovery codes per user, generated on 2FA enable. code_hash stores
            a BCrypt hash (RateLimitUtil-style secrets never stored raw) — the raw code is
            returned to the client exactly once, at generation time, and never persisted.</comment>

        <createTable tableName="recovery_codes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="code_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
            constraintName="fk_recovery_codes_user"
            baseTableName="recovery_codes" baseColumnNames="user_id"
            referencedTableName="users" referencedColumnNames="id"
            onDelete="CASCADE"/>

        <createIndex indexName="idx_recovery_codes_user_id" tableName="recovery_codes">
            <column name="user_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="recovery_codes"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
