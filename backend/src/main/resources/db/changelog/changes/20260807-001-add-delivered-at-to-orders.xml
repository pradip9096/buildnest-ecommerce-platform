<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Issue #88 (RET-01): delivered_at is required to compute the 30-day return window -->
    <changeSet id="20260807-001-add-delivered-at-to-orders" author="buildnest-team">
        <comment>Add delivered_at timestamp to orders, set on transition to DELIVERED (RET-01, #88)</comment>

        <addColumn tableName="orders">
            <column name="delivered_at" type="TIMESTAMP"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="orders" columnName="delivered_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
