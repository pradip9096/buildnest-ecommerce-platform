<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Issue #104 / #87 (SHIP-01): Shipping method and cost calculation -->
    <changeSet id="20260624-006-create-shipping-methods" author="buildnest-team">
        <comment>Create shipping_methods table for shipping cost calculation (SHIP-01, #87)</comment>

        <createTable tableName="shipping_methods">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="base_cost" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="cost_per_kg" type="DECIMAL(19,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="estimated_days_min" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="estimated_days_max" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="shipping_methods" indexName="idx_shipping_methods_active">
            <column name="is_active"/>
        </createIndex>

        <rollback>
            <dropTable tableName="shipping_methods"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
