# Template for mysqld_exporter's --config.my-cnf (#122). mysqld_exporter v0.15+ removed
# DATA_SOURCE_NAME env var support entirely -- credentials must come from a mounted my.cnf
# file. Rendered by the mysqld-exporter-config-render sidecar (mirrors prometheus-config-render,
# #324) so the real password still comes from MYSQL_ROOT_PASSWORD, not a committed file.
[client]
user = root
password = __MYSQL_ROOT_PASSWORD__
host = mysql
port = 3306
