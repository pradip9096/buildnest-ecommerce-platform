	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2025.0.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- CVE-2025-37731 (#332): spring-data-elasticsearch 5.5.13 (via Boot 3.5.16)
			     still pins elasticsearch-java/elasticsearch-rest-client 8.18.8, which has no
			     further patch in the 8.18.x line. Override to latest 8.19.x (server is
			     Elasticsearch 8.10 per CLAUDE.md; the Java client maintains compatibility
			     across 8.x minor versions). -->
			<dependency>
				<groupId>co.elastic.clients</groupId>
				<artifactId>elasticsearch-java</artifactId>
				<version>8.19.18</version>
			</dependency>
			<dependency>
				<groupId>org.elasticsearch.client</groupId>
				<artifactId>elasticsearch-rest-client</artifactId>
				<version>8.19.18</version>
			</dependency>

			<!-- CVE-2026-29062/54512-54518 (#332): elasticsearch-java 8.19.18 (bumped above)
			     pins tools.jackson.core:jackson-{core,databind} 3.0.0 directly in its own POM
			     (runtime scope) — a brand-new Jackson 3.x major release with its own fresh
			     CVEs, introduced transitively by that bump itself. Override to latest stable
			     Jackson 3.x. -->
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>3.2.0</version>
			</dependency>
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>3.2.0</version>
			</dependency>

			<!-- CVE-2026-53914 (#332): kotlin-stdlib 1.9.25, pulled in transitively via
			     okhttp (razorpay-java), is the last patch in the 1.9.x line. 2.0.21 (first
			     override attempt) still matched CVE-2026-53914 in a dependency-check re-run —
			     override to the latest stable 2.4.x instead. kotlin-stdlib maintains binary
			     backward compatibility across minor versions, so this is safe for a JAR-only
			     runtime consumer (no Kotlin source is compiled in this project). -->
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib</artifactId>
				<version>2.4.0</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib-common</artifactId>
				<!-- kotlin-stdlib-common stopped publishing real JARs (POM-only, Gradle
				     module-metadata multiplatform resolution) after 2.0.21 — confirmed via
				     direct Maven Central HEAD requests, 2.1.0+ all 404 on the jar. Not the
				     artifact CVE-2026-53914 was flagged against anyway (that's kotlin-stdlib
				     itself, overridden above to 2.4.0), so pin this one at its last real
				     release instead of following the others. -->
				<version>2.0.21</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib-jdk7</artifactId>
				<version>2.4.0</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-stdlib-jdk8</artifactId>
				<version>2.4.0</version>
			</dependency>

			<!-- CVE-2026-65898 (#611): springdoc-openapi-starter-webmvc-ui 2.8.17 (latest
			     release as of this fix) still bundles org.webjars:swagger-ui 5.32.2, whose
			     vendored DOMPurify has this CVE. No newer springdoc-openapi release bundles a
			     patched swagger-ui yet, so override the webjar directly to the latest available
			     release on Maven Central (5.32.11, includes the DOMPurify fix shipped in
			     swagger-ui 5.32.7+). swagger-ui is a static UI bundle (webjar), not compiled
			     Java code springdoc calls into by API surface, so a same-major.minor bump is
			     safe without a springdoc-openapi version change. -->
			<dependency>
				<groupId>org.webjars</groupId>
				<artifactId>swagger-ui</artifactId>
				<version>5.32.11</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Maven Profiles for Different Test Scenarios -->
	<profiles>
		<!-- Unit Tests Only (default) -->
		<profile>
			<id>unit-tests</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludedGroups>e2e,stress,integration</excludedGroups>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- All Tests (Unit + Integration) -->
		<profile>
			<id>all-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludedGroups>e2e,stress</excludedGroups>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- E2E Tests Only -->
		<profile>
			<id>e2e-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<groups>e2e</groups>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Stress Tests Only -->
		<profile>
			<id>stress-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<groups>stress</groups>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- CI/CD Profile with Coverage -->
		<profile>
			<id>ci</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludedGroups>e2e,stress</excludedGroups>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>jacoco-check</id>
								<goals>
									<goal>check</goal>
								</goals>
								<configuration>
									<rules>
										<rule>
											<element>PACKAGE</element>
											<limits>
												<limit>
													<counter>INSTRUCTION</counter>
													<value>COVEREDRATIO</value>
													<minimum>0.85</minimum>
												</limit>
											</limits>
										</rule>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- OWASP Dependency-Check — fail build on CVSS >= 7.0 (NFR-SEC-01) -->
		<profile>
			<id>owasp</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<version>10.0.4</version>
						<executions>
							<execution>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<!-- Fail on CVSS base score >= 7.0 (high/critical) -->
							<failBuildOnCVSS>7</failBuildOnCVSS>
							<format>HTML</format>
							<!-- Stable NVD DB location so CI can cache it across runs -->
							<dataDirectory>${user.home}/.dependency-check/data</dataDirectory>
							<!-- Exclude scopes not deployed to production -->
							<skipTestScope>true</skipTestScope>
							<skipProvidedScope>true</skipProvidedScope>
							<!-- .NET assembly analysis is irrelevant for this project -->
							<assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
							<!-- Optional NVD API key — speeds up database updates significantly;
							     set NVD_API_KEY secret in GitHub to avoid rate limiting -->
							<nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
							<!-- Issue #332: this profile's plugin instance previously had no
							     suppressionFiles entry at all — accepted-risk/false-positive
							     suppressions (owasp-suppressions.xml) were silently not applied
							     here even though they were wired into the other (default-build,
							     9.0.9) dependency-check-maven instance. This is the instance CI
							     actually runs (`mvn verify -Powasp`), so this was the real gap. -->
							<suppressionFiles>
								<suppressionFile>owasp-suppressions.xml</suppressionFile>
							</suppressionFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>21</source>
					<target>21</target>
					<compilerArgs>
						<!-- Suppress annotation processing warnings and unprocessed annotation warnings -->
						<arg>-Xlint:-options</arg>
						<arg>-Xlint:-processing</arg>
						<!-- Enable all other warnings -->
						<arg>-Xlint:all</arg>
					</compilerArgs>
					<!-- Specify annotation processors to reduce warnings -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Allow ByteBuddy agent for Mockito without JDK warnings -->
					<argLine>${jacoco.argLine} -XX:+EnableDynamicAgentLoading -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.11</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
						<configuration>
							<propertyName>jacoco.argLine</propertyName>
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
						<configuration>
							<excludes>
								<exclude>**/model/dto/**</exclude>
								<exclude>**/model/payload/**</exclude>
								<!-- model/entity and model/elasticsearch are intentionally NOT excluded here:
								     kept in sync with the plugin-level default excludes below, so this report
								     reflects the same scope the jacoco-check gate (ci profile) enforces. -->
								<exclude>**/config/**</exclude>
								<exclude>**/*Application.class</exclude>
								<exclude>**/exception/ResourceNotFoundException.class</exclude>
								<exclude>**/exception/AccessDeniedException.class</exclude>
								<exclude>**/exception/PaymentProcessingException.class</exclude>
								<exclude>**/exception/ExternalServiceException.class</exclude>
								<exclude>**/util/EventLogger.class</exclude>
								<exclude>**/util/TransactionLogger.class</exclude>
								<exclude>**/util/LoggingStandards.class</exclude>
								<exclude>**/util/LoggingStandards$*.class</exclude>
							</excludes>
						</configuration>
					</execution>
					<execution>
						<id>report-aggregate</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
						<configuration>
							<excludes>
								<exclude>**/model/dto/**</exclude>
								<exclude>**/model/payload/**</exclude>
							<!-- Entity and elasticsearch models now have comprehensive tests -->
							<!-- <exclude>**/model/entity/**</exclude> -->
							<!-- <exclude>**/model/elasticsearch/**</exclude> -->
								<exclude>**/config/**</exclude>
								<exclude>**/*Application.class</exclude>
								<exclude>**/exception/ResourceNotFoundException.class</exclude>
								<exclude>**/exception/AccessDeniedException.class</exclude>
								<exclude>**/exception/PaymentProcessingException.class</exclude>
								<exclude>**/exception/ExternalServiceException.class</exclude>
								<exclude>**/util/EventLogger.class</exclude>
								<exclude>**/util/TransactionLogger.class</exclude>
								<exclude>**/util/LoggingStandards.class</exclude>
								<exclude>**/util/LoggingStandards$*.class</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
				<configuration>
					<excludes>
						<!-- Exclude generated code and DTOs from coverage -->
						<exclude>**/model/dto/**</exclude>
						<exclude>**/model/payload/**</exclude>
						<!-- Entity and elasticsearch models now have comprehensive tests -->
						<!-- <exclude>**/model/entity/**</exclude> -->
						<!-- <exclude>**/model/elasticsearch/**</exclude> -->
						<exclude>**/config/**</exclude>
						<exclude>**/*Application.class</exclude>
						<!-- Exception classes: trivial constructors delegating to super(); no branching logic -->
						<exclude>**/exception/ResourceNotFoundException.class</exclude>
						<exclude>**/exception/AccessDeniedException.class</exclude>
						<exclude>**/exception/PaymentProcessingException.class</exclude>
						<exclude>**/exception/ExternalServiceException.class</exclude>
						<!-- Logging/tracing utilities: no branching business logic -->
						<exclude>**/util/EventLogger.class</exclude>
						<exclude>**/util/TransactionLogger.class</exclude>
						<exclude>**/util/LoggingStandards.class</exclude>
						<exclude>**/util/LoggingStandards$*.class</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Gatling Maven Plugin for load testing -->
			<plugin>
				<groupId>io.gatling</groupId>
				<artifactId>gatling-maven-plugin</artifactId>
				<version>4.7.0</version>
			</plugin>
			<!-- OWASP Dependency-Check Plugin (Mitigation #6: Security scanning) -->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>9.0.9</version>
				<configuration>
					<failBuildOnCVSS>7</failBuildOnCVSS>
					<failOnError>false</failOnError>
					<nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
					<nvdApiDelay>6000</nvdApiDelay>
					<suppressionFiles>
						<suppressionFile>owasp-suppressions.xml</suppressionFile>
					</suppressionFiles>
					<formats>
						<format>HTML</format>
						<format>JSON</format>
					</formats>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Maven Javadoc Plugin (HIGH #8 - Enforce 100% Javadoc Coverage) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<failOnError>true</failOnError>
					<failOnWarnings>true</failOnWarnings>
					<show>private</show>
					<doclint>all</doclint>
					<quiet>false</quiet>
					<additionalOptions>
						<additionalOption>-Xdoclint:all</additionalOption>
						<additionalOption>-Xdoclint:-missing</additionalOption>
					</additionalOptions>
					<excludePackageNames>
						com.example.buildnest_ecommerce.model.dto,
						com.example.buildnest_ecommerce.model.payload
					</excludePackageNames>
					<tags>
						<tag>
							<name>author</name>
							<placement>a</placement>
							<head>Author:</head>
						</tag>
						<tag>
							<name>since</name>
							<placement>a</placement>
							<head>Since:</head>
						</tag>
					</tags>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
					<execution>
						<id>generate-javadoc-report</id>
						<phase>verify</phase>
						<goals>
							<goal>javadoc</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- SpotBugs Maven Plugin (#353): declared here so `mvn spotbugs:check` resolves at all.
			     com.github.spotbugs is not one of Maven's default-searched plugin groups
			     (org.apache.maven.plugins, org.codehaus.mojo, etc.) — a bare CLI goal reference
			     with no pom.xml declaration fails outright with "No plugin found for prefix
			     'spotbugs'", which is exactly what silently broke this check before #353.
			     Deliberately no <executions> binding, matching checkstyle-maven-plugin's setup in
			     this same file — CI invokes `spotbugs:check` as an explicit standalone step, not on
			     every build phase, and bare declaration is sufficient for the CLI prefix to resolve.

			     Blocking threshold (#317): threshold=High makes `spotbugs:check` fail the build
			     on Priority-1 (High) findings only — Medium/Low stay advisory (reported, not
			     blocking) since the 97 remaining Medium findings (mostly EI_EXPOSE_REP/REP2 and
			     VA_FORMAT_STRING_USES_NEWLINE) are higher-effort and tracked separately (see #316's
			     other sub-issues). Safe to block immediately with no grace-period ratchet (unlike
			     CheckStyle's maxAllowedViolations ceiling) because the 4 pre-existing High-priority
			     findings were fixed in the same change that introduced this threshold — the ceiling
			     starts at zero. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.10.2.0</version>
				<configuration>
					<threshold>High</threshold>
					<effort>Max</effort>
					<failOnError>true</failOnError>
				</configuration>
			</plugin>
			<!-- PIT Mutation Testing Plugin (Section 3.1 - EXHAUSTIVE_RECOMMENDATION_REPORT) -->
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.16.1</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>1.2.2</version>
					</dependency>
				</dependencies>
				<configuration>
					<skip>${pitest.skip}</skip>
					<targetClasses>
						<param>com.example.buildnest_ecommerce.service.*</param>
						<param>com.example.buildnest_ecommerce.util.*</param>
					</targetClasses>
					<targetTests>
						<param>com.example.buildnest_ecommerce.service.*ImplTest</param>
						<param>com.example.buildnest_ecommerce.service.*ServiceTest</param>
						<param>com.example.buildnest_ecommerce.util.*Test</param>
					</targetTests>
					<excludedTestClasses>
						<!-- Exclude Spring Boot integration tests that require full application context -->
						<param>**/*IntegrationTest</param>
						<param>**/*E2ETest</param>
						<param>**/*StressTest</param>
						<param>**/*ReliabilityTest</param>
						<param>**/*PerformanceTest</param>
						<param>**/*PerformanceBaselineTest</param>
						<param>**/*ControllerTest</param>
						<param>com.example.buildnest_ecommerce.e2e.*</param>
						<param>com.example.buildnest_ecommerce.stress.*</param>
						<param>com.example.buildnest_ecommerce.reliability.*</param>
						<param>com.example.buildnest_ecommerce.performance.*</param>
						<param>com.example.buildnest_ecommerce.validation.*</param>
						<param>com.example.buildnest_ecommerce.security.*SecurityTest</param>
						<param>com.example.buildnest_ecommerce.rbac.*</param>
						<param>com.example.buildnest_ecommerce.repository.*</param>
						<param>com.example.buildnest_ecommerce.api.*</param>
						<param>com.example.buildnest_ecommerce.admin.*</param>
						<param>com.example.buildnest_ecommerce.analytics.*</param>
						<param>com.example.buildnest_ecommerce.category.*</param>
						<param>com.example.buildnest_ecommerce.inventory.*</param>
						<param>com.example.buildnest_ecommerce.payment.*</param>
					</excludedTestClasses>
					<!-- mutationThreshold gates on MUTATION SCORE = killed / generated (includes
					     NO_COVERAGE mutants in the denominator). The console line "Mutation score
					     of N" is exactly what this gate evaluates. Test strength (killed / reached,
					     i.e. excluding no-coverage) is printed separately and is NOT gated.
					     Current score: 77% (1,284/1,658). Ratchet plan: 79% end-M4 → 81% start-M5 → 83% end-M5. -->
					<mutationThreshold>77</mutationThreshold>
					<coverageThreshold>70</coverageThreshold>
					<outputFormats>
						<outputFormat>HTML</outputFormat>
						<outputFormat>XML</outputFormat>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
					<mutators>
						<mutator>DEFAULTS</mutator>
					</mutators>
					<excludedClasses>
						<param>com.example.buildnest_ecommerce.model.dto.*</param>
						<param>com.example.buildnest_ecommerce.model.payload.*</param>
						<param>com.example.buildnest_ecommerce.config.*</param>
						<param>com.example.buildnest_ecommerce.*Application</param>
					</excludedClasses>
					<threads>4</threads>
					<timeoutConstant>10000</timeoutConstant>
					<verbose>false</verbose>
				</configuration>
				<executions>
					<execution>
						<id>pit-report</id>
						<phase>verify</phase>
						<goals>
							<goal>mutationCoverage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- Reporting Section (HIGH #8 - Javadoc Coverage Reporting) -->
	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.6.3</version>
				<reportSets>
					<reportSet>
						<id>default</id>
						<reports>
							<report>javadoc</report>
						</reports>
					</reportSet>
					<reportSet>
						<id>aggregate</id>
						<inherited>false</inherited>
						<reports>
							<report>aggregate</report>
						</reports>
					</reportSet>
				</reportSets>
			</plugin>
		</plugins>
	</reporting>

</project>
