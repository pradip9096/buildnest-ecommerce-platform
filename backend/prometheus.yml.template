# This is a TEMPLATE, not the file Prometheus actually reads -- the prometheus-config-render
# service (docker-compose.yml) substitutes the environment placeholder below with the real
# ENVIRONMENT value (.env, defaults to "dev") and writes the rendered result to a shared
# volume before the prometheus container starts. Native Prometheus env-var substitution for
# external_labels exists (--enable-feature=expand-external-labels) but only from v2.55+; this
# repo pins v2.52.0, and bumping to the current 3.x LTS line to get it was judged out of scope
# for this fix (real breaking-change risk to alerts.yml/behavior, not verified here) -- see #324.
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'buildnest-ecommerce'
    environment: '__ENVIRONMENT__'

# Alertmanager configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

# Alert rule files (PERFORMANCE_OPTIMIZATION_GUIDE - Section 7)
rule_files:
  - 'alerts.yml'

scrape_configs:
  # BuildNest Application Metrics (PERFORMANCE_OPTIMIZATION_GUIDE - Monitoring & Metrics)
  - job_name: 'buildnest'
    metrics_path: '/actuator/prometheus'
    basic_auth:
      username: '__MONITORING_USERNAME__'
      password: '__MONITORING_PASSWORD__'
    static_configs:
      - targets: ['buildnest-ecommerce:8080']
        labels:
          service: 'buildnest-ecommerce'
          tier: 'application'
    scrape_interval: 15s
    scrape_timeout: 10s
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance

  # Prometheus Self-Monitoring
  - job_name: 'prometheus'
    static_configs:
      - targets: ['prometheus:9090']
        labels:
          service: 'prometheus'
          tier: 'monitoring'

  # MySQL metrics (#122) -- re-added now that mysqld-exporter is actually deployed
  # (docker-compose.yml). See #325 for why this was previously removed.
  - job_name: 'mysql'
    static_configs:
      - targets: ['mysqld-exporter:9104']
        labels:
          service: 'mysql'
          tier: 'database'

  # Redis metrics (#122) -- re-added now that redis-exporter is actually deployed
  # (docker-compose.yml). See #325 for why this was previously removed.
  - job_name: 'redis'
    static_configs:
      - targets: ['redis-exporter:9121']
        labels:
          service: 'redis'
          tier: 'cache'

  # Host-level metrics (#122) -- feeds the HighDiskUsage alert rule (alerts.yml), which was
  # previously dangling with no exporter. Re-added now that node-exporter is deployed
  # (docker-compose.yml). See #325 for why this was previously removed.
  - job_name: 'node'
    static_configs:
      - targets: ['node-exporter:9100']
        labels:
          service: 'node'
          tier: 'infrastructure'
