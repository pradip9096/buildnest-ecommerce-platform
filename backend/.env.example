# =============================================================================
# BuildNest E-Commerce Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all required values before starting.
#
#   cp .env.example .env
#
# Column guide (inline comments):
#   Type    — string | int | boolean | url | ms (milliseconds) | s (seconds)
#   Default — value used when the variable is absent (if any)
#   Class   — SECRET (never commit) | non-secret
#   Req     — REQUIRED (no default; app fails without it) | optional
# =============================================================================


# -----------------------------------------------------------------------------
# Docker Compose Infrastructure
# These variables are consumed by docker-compose.yml, not by the Spring app.
# -----------------------------------------------------------------------------

# MySQL root password used when Docker initialises the container.
# Production minimum: 32 random characters. Generate with: openssl rand -base64 32
# Type: string | Class: SECRET | Req: REQUIRED
MYSQL_ROOT_PASSWORD=

# MySQL database name created on first container start.
# Type: string | Default: buildnest_ecommerce | Class: non-secret | Req: REQUIRED
MYSQL_DATABASE=buildnest_ecommerce

# Elasticsearch bootstrap password (Docker only — sets the built-in elastic user).
# Type: string | Class: SECRET | Req: REQUIRED
ELASTIC_PASSWORD=


# -----------------------------------------------------------------------------
# Database — Spring DataSource (MySQL)
# -----------------------------------------------------------------------------

# Full JDBC connection URL.
# Quoted because start.sh sources this file with `bash source`, and an unescaped `&`
# in an unquoted assignment is interpreted as a shell background operator, truncating the value.
# Type: url | Default: jdbc:mysql://localhost:3306/buildnest_ecommerce?useUnicode=true&characterEncoding=UTF-8 | Class: non-secret | Req: optional
SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/buildnest_ecommerce?useUnicode=true&characterEncoding=UTF-8"

# Database username.
# Type: string | Default: root | Class: non-secret | Req: optional
SPRING_DATASOURCE_USERNAME=root

# Database password.  Must match MYSQL_ROOT_PASSWORD (or the app-user password).
# Type: string | Class: SECRET | Req: REQUIRED
SPRING_DATASOURCE_PASSWORD=

# Liquibase schema used as the default schema for migration scripts.
# Type: string | Default: buildnest_ecommerce | Class: non-secret | Req: optional
SPRING_DATASOURCE_URL_SCHEMA=buildnest_ecommerce

# Enable or disable Liquibase migrations on startup.
# Type: boolean | Default: true | Class: non-secret | Req: optional
LIQUIBASE_ENABLED=true


# -----------------------------------------------------------------------------
# Database — HikariCP Connection Pool
# -----------------------------------------------------------------------------

# Maximum number of connections in the pool.
# Type: int | Default: 20 (dev), 30 (prod) | Class: non-secret | Req: optional
DB_POOL_MAX_SIZE=20

# Minimum number of idle connections kept in the pool.
# Type: int | Default: 10 (dev), 15 (prod) | Class: non-secret | Req: optional
DB_POOL_MIN_IDLE=10

# Maximum milliseconds to wait for a connection from the pool.
# Type: ms | Default: 30000 | Class: non-secret | Req: optional
DB_CONNECTION_TIMEOUT=30000

# Maximum milliseconds a connection may sit idle before being retired.
# Type: ms | Default: 600000 | Class: non-secret | Req: optional
DB_IDLE_TIMEOUT=600000

# Maximum lifetime of a connection in the pool.
# Type: ms | Default: 1800000 | Class: non-secret | Req: optional
DB_MAX_LIFETIME=1800000


# -----------------------------------------------------------------------------
# JWT — Authentication Tokens
# CRITICAL: JWT_SECRET has no default and the application will not start
# without it.  Generate with: openssl rand -base64 64
# Minimum key length: 512 bits (64 bytes).
# -----------------------------------------------------------------------------

# HMAC-SHA secret used to sign and verify JWT access and refresh tokens.
# Type: string (Base64) | Class: SECRET | Req: REQUIRED
JWT_SECRET=

# Access token lifetime in milliseconds (default 15 min).
# Type: ms | Default: 900000 | Class: non-secret | Req: optional
JWT_EXPIRATION=900000

# Refresh token lifetime in milliseconds (default 30 days).
# Type: ms | Default: 2592000000 | Class: non-secret | Req: optional
JWT_REFRESH_EXPIRATION=2592000000

# Password-reset token lifetime in milliseconds (default 15 min, per OWASP).
# Type: ms | Default: 900000 | Class: non-secret | Req: optional
PASSWORD_RESET_EXPIRATION=900000

# Dedicated read-only Basic Auth credential Prometheus uses to scrape /actuator/prometheus
# (#359). NOT the ADMIN login account -- scoped to this one endpoint only, see
# SecurityConfig#actuatorMonitoringSecurityFilterChain. Rendered into prometheus.yml via the
# prometheus-config-render sidecar (same mechanism as #324's ENVIRONMENT substitution).
# CRITICAL: MONITORING_PASSWORD must be overridden to a non-default value in production --
# SecurityConfig fails fast at startup otherwise.
# Type: string | Default: monitoring | Class: non-secret | Req: optional
MONITORING_USERNAME=monitoring

# Type: string | Default: changeme-monitoring-password | Class: SECRET | Req: REQUIRED in production
MONITORING_PASSWORD=


# -----------------------------------------------------------------------------
# Redis — Cache & Rate Limiting
# -----------------------------------------------------------------------------

# Redis server hostname.
# Type: string | Default: localhost | Class: non-secret | Req: optional
REDIS_HOST=localhost

# Redis server port.
# Type: int | Default: 6379 | Class: non-secret | Req: optional
REDIS_PORT=6379

# Redis AUTH password.  Leave empty if no password is set.
# Production minimum: 32 random characters. Generate with: openssl rand -base64 32
# Type: string | Class: SECRET | Req: optional
REDIS_PASSWORD=

# Connection timeout in milliseconds.
# Type: ms | Default: 3000 | Class: non-secret | Req: optional
REDIS_TIMEOUT=3000

# Jedis pool — maximum active connections.
# Type: int | Default: 8 (dev), 32 (prod) | Class: non-secret | Req: optional
REDIS_POOL_MAX_ACTIVE=8

# Jedis pool — maximum idle connections.
# Type: int | Default: 8 (dev), 16 (prod) | Class: non-secret | Req: optional
REDIS_POOL_MAX_IDLE=8

# Jedis pool — minimum idle connections.
# Type: int | Default: 0 (dev), 8 (prod) | Class: non-secret | Req: optional
REDIS_POOL_MIN_IDLE=0

# Jedis pool — maximum milliseconds to wait for an available connection.
# Type: ms | Default: 5000 | Class: non-secret | Req: optional
REDIS_POOL_MAX_WAIT=5000


# -----------------------------------------------------------------------------
# Cache TTL (Redis)
# All values in milliseconds.
# -----------------------------------------------------------------------------

# Global default cache TTL.
# Type: ms | Default: 900000 (dev), 3600000 (prod) | Class: non-secret | Req: optional
CACHE_TTL=900000

# Per-region overrides.
# Type: ms | Class: non-secret | Req: optional
CACHE_TTL_PRODUCTS=300000
CACHE_TTL_CATEGORIES=3600000
CACHE_TTL_USERS=1800000
CACHE_TTL_ORDERS=600000
CACHE_TTL_RATE_LIMIT=60000
CACHE_TTL_AUDIT_LOGS=900000
CACHE_TTL_PERMISSIONS=3600000
CACHE_TTL_INVENTORY=300000


# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------

# Enable Elasticsearch integration (set true in staging/production).
# Type: boolean | Default: false | Class: non-secret | Req: optional
ELASTICSEARCH_ENABLED=false

# Enable Spring Data Elasticsearch repositories.
# Type: boolean | Default: false | Class: non-secret | Req: optional
ELASTICSEARCH_REPOSITORIES_ENABLED=false

# Elasticsearch hostname.
# Type: string | Default: localhost | Class: non-secret | Req: optional
ELASTICSEARCH_HOST=localhost

# Elasticsearch HTTP port.
# Type: int | Default: 9200 | Class: non-secret | Req: optional
ELASTICSEARCH_PORT=9200

# Elasticsearch username (matches ELASTIC_PASSWORD above for the built-in user).
# Type: string | Default: elastic | Class: non-secret | Req: optional
ELASTICSEARCH_USERNAME=elastic

# Elasticsearch password.  Must match ELASTIC_PASSWORD set in Docker.
# Type: string | Class: SECRET | Req: optional (REQUIRED when ELASTICSEARCH_ENABLED=true)
ELASTICSEARCH_PASSWORD=

# Enable TLS for the Elasticsearch connection.
# Type: boolean | Default: false | Class: non-secret | Req: optional
ELASTICSEARCH_SSL_ENABLED=false

# Alerting — enable CPU/memory/error-rate threshold alerts sent to webhook.
# Type: boolean | Default: true | Class: non-secret | Req: optional
ELASTICSEARCH_ALERT_ENABLED=true

# CPU usage percentage that triggers an alert.
# Type: int | Default: 80 | Class: non-secret | Req: optional
ELASTICSEARCH_ALERT_CPU_THRESHOLD=80

# Memory usage percentage that triggers an alert.
# Type: int | Default: 90 | Class: non-secret | Req: optional
ELASTICSEARCH_ALERT_MEMORY_THRESHOLD=90

# Error rate percentage that triggers an alert.
# Type: int | Default: 5 | Class: non-secret | Req: optional
ELASTICSEARCH_ALERT_ERROR_RATE_THRESHOLD=5

# Webhook URL to receive Elasticsearch alerts (leave empty to disable delivery).
# Type: url | Class: non-secret | Req: optional
ELASTICSEARCH_ALERT_WEBHOOK_URL=

# Enable Elasticsearch metrics collection.
# Type: boolean | Default: true | Class: non-secret | Req: optional
ELASTICSEARCH_METRICS_ENABLED=true


# -----------------------------------------------------------------------------
# Rate Limiting (Bucket4j / Redis)
# requests = token bucket capacity; duration = refill window in seconds.
# -----------------------------------------------------------------------------

# Login endpoint.
# Type: int / s | Default: 3 / 300 | Class: non-secret | Req: optional
RATE_LIMIT_LOGIN_REQUESTS=3
RATE_LIMIT_LOGIN_DURATION=300

# Password-reset endpoint.
# Type: int / s | Default: 3 / 3600 | Class: non-secret | Req: optional
RATE_LIMIT_PASSWORD_RESET_REQUESTS=3
RATE_LIMIT_PASSWORD_RESET_DURATION=3600

# Token-refresh endpoint.
# Type: int / s | Default: 10 / 60 | Class: non-secret | Req: optional
RATE_LIMIT_REFRESH_TOKEN_REQUESTS=10
RATE_LIMIT_REFRESH_TOKEN_DURATION=60

# Product-search endpoint.
# Type: int / s | Default: 60 / 60 | Class: non-secret | Req: optional
RATE_LIMIT_PRODUCT_SEARCH_REQUESTS=60
RATE_LIMIT_PRODUCT_SEARCH_DURATION=60

# Admin endpoints.
# Type: int / s | Default: 50 / 60 | Class: non-secret | Req: optional
RATE_LIMIT_ADMIN_REQUESTS=50
RATE_LIMIT_ADMIN_DURATION=60

# General authenticated user endpoints.
# Type: int / s | Default: 500 / 60 | Class: non-secret | Req: optional
RATE_LIMIT_USER_REQUESTS=500
RATE_LIMIT_USER_DURATION=60


# -----------------------------------------------------------------------------
# Circuit Breakers (Resilience4j)
# -----------------------------------------------------------------------------

# Redis circuit breaker thresholds.
# Type: int / ms / int | Defaults: 70 / 60000 / 5 | Class: non-secret | Req: optional
REDIS_CB_FAILURE_THRESHOLD=70
REDIS_CB_WAIT_DURATION=60000
REDIS_CB_MIN_CALLS=5

# Database circuit breaker thresholds.
# Type: int / ms / int | Defaults: 50 / 30000 / 10 | Class: non-secret | Req: optional
DB_CB_FAILURE_THRESHOLD=50
DB_CB_WAIT_DURATION=30000
DB_CB_MIN_CALLS=10


# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------

# Razorpay API key ID.  Use test_* keys in non-production environments.
# Type: string | Class: SECRET | Req: REQUIRED (for checkout to function)
RAZORPAY_KEY_ID=

# Razorpay API key secret.
# Type: string | Class: SECRET | Req: REQUIRED (for checkout to function)
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret (from the webhook config in the Razorpay
# dashboard, not the API key secret above). No default (#114) — required
# at startup whenever the app boots, not just for checkout.
# Type: string | Class: SECRET | Req: REQUIRED
RAZORPAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# SSL / TLS (Server)
# Required only when running the app with HTTPS directly (not behind a proxy).
# -----------------------------------------------------------------------------

# Enable TLS on the embedded Tomcat server.
# Type: boolean | Default: false (dev), true (prod) | Class: non-secret | Req: optional
SERVER_SSL_ENABLED=false

# Path to the PKCS12 keystore file.
# Type: string | Class: non-secret | Req: optional (REQUIRED when SERVER_SSL_ENABLED=true)
SERVER_SSL_KEY_STORE=

# Password for the PKCS12 keystore.
# Type: string | Class: SECRET | Req: optional (REQUIRED when SERVER_SSL_ENABLED=true)
SERVER_SSL_KEY_STORE_PASSWORD=


# -----------------------------------------------------------------------------
# OAuth2 Social Login (production only)
# Leave these unset in local development unless testing OAuth2 flows.
# -----------------------------------------------------------------------------

# Google OAuth2 credentials.
# Type: string | Class: SECRET | Req: optional (REQUIRED when OAuth2 enabled in prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth2 credentials.
# Type: string | Class: SECRET | Req: optional (REQUIRED when OAuth2 enabled in prod)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Logstash (production log shipping)
# Consumed by logback-spring.xml when the logstash Spring profile is active.
# -----------------------------------------------------------------------------

# Logstash TCP endpoint hostname.
# Type: string | Default: localhost | Class: non-secret | Req: optional
LOGSTASH_HOST=localhost

# Logstash TCP endpoint port.
# Type: int | Default: 5000 | Class: non-secret | Req: optional
LOGSTASH_PORT=5000


# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------

# Master switch — enable outbound webhook event delivery.
# Type: boolean | Default: true | Class: non-secret | Req: optional
WEBHOOK_EVENTS_ENABLED=true

# Per-event-type handler toggles.
# Type: boolean | Default: true | Class: non-secret | Req: optional
WEBHOOK_HANDLERS_PAYMENT=true
WEBHOOK_HANDLERS_INVENTORY=true
WEBHOOK_HANDLERS_ORDER=true
WEBHOOK_HANDLERS_ALERT=true

# Maximum delivery retry attempts.
# Type: int | Default: 3 | Class: non-secret | Req: optional
WEBHOOK_MAX_RETRIES=3

# Delay between retry attempts in milliseconds.
# Type: ms | Default: 5000 | Class: non-secret | Req: optional
WEBHOOK_RETRY_DELAY=5000


# -----------------------------------------------------------------------------
# Email / SMTP (#62, #327)
# -----------------------------------------------------------------------------

# SMTP host. For local dev, point at the Mailpit container instead of a real
# provider (docker-compose service "mailpit"; web UI at http://localhost:8025) —
# no real credentials needed locally, and nothing leaves your machine.
# Type: string | Default: smtp.gmail.com | Class: non-secret | Req: optional
MAIL_HOST=mailpit

# SMTP port. Mailpit listens on 1025; real providers typically use 587 (STARTTLS).
# Type: int | Default: 587 | Class: non-secret | Req: optional
MAIL_PORT=1025

# SMTP auth username. Leave blank for Mailpit (no auth required locally).
# Type: string | Class: SECRET | Req: optional (required for a real SMTP provider)
MAIL_USERNAME=

# SMTP auth password / app password. Leave blank for Mailpit.
# Type: string | Class: SECRET | Req: optional (required for a real SMTP provider)
MAIL_PASSWORD=

# From-address and display name used on all outbound emails (order confirmation,
# password reset, shipping updates, etc.).
# Type: string | Default: noreply@buildnest.com | Class: non-secret | Req: optional
MAIL_FROM=noreply@buildnest.com
MAIL_FROM_NAME=BuildNest

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# Deployment environment tag attached to all Micrometer metrics.
# Type: string | Default: dev | Class: non-secret | Req: optional
ENVIRONMENT=dev

# Grafana admin login (#122). Change before exposing Grafana outside local dev.
# Type: string | Default: admin | Class: SECRET (password) | Req: optional
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Alertmanager notification channels (#122) — enable one or both. Slack requires a webhook
# URL (https://api.slack.com/messaging/webhooks); email reuses the SMTP settings above
# (MAIL_HOST/MAIL_PORT/MAIL_USERNAME/MAIL_PASSWORD) as the smarthost.
# Type: boolean | Default: false | Class: non-secret | Req: optional
ALERTMANAGER_SLACK_ENABLED=false
# Type: string | Class: SECRET | Req: required if ALERTMANAGER_SLACK_ENABLED=true
ALERTMANAGER_SLACK_WEBHOOK_URL=
# Type: string | Default: #alerts | Class: non-secret | Req: optional
ALERTMANAGER_SLACK_CHANNEL=#alerts
# Type: boolean | Default: false | Class: non-secret | Req: optional
ALERTMANAGER_EMAIL_ENABLED=false
# Comma-separated recipient list.
# Type: string | Class: non-secret | Req: required if ALERTMANAGER_EMAIL_ENABLED=true
ALERTMANAGER_EMAIL_TO=


# -----------------------------------------------------------------------------
# Chaos Engineering (never enable in production)
# -----------------------------------------------------------------------------

# Master switch for chaos fault injection.
# Type: boolean | Default: false | Class: non-secret | Req: optional
CHAOS_ENABLED=false

# Fraction of requests that return a synthetic error (0.0–1.0).
# Type: float | Default: 0.02 | Class: non-secret | Req: optional
CHAOS_ERROR_RATE=0.02

# Artificial latency injected per request in milliseconds.
# Type: ms | Default: 200 | Class: non-secret | Req: optional
CHAOS_DELAY_MS=200


# -----------------------------------------------------------------------------
# Security Scanning
# -----------------------------------------------------------------------------

# NVD API key for OWASP dependency-check (pom.xml). Without it, dependency-check
# still runs but is aggressively rate-limited against the NVD API. Generate at
# https://nvd.nist.gov/developers/request-an-api-key. In CI this is set as the
# GitHub Actions repository secret NVD_API_KEY, not read from this file.
# Type: string | Class: SECRET | Req: optional
NVD_API_KEY=
